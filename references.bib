@ARTICLE{Uluc2024-cd,
  title     = "Non-invasive measurements of blood glucose levels by time-gating
               mid-infrared optoacoustic signals",
  author    = "Uluç, Nasire and Glasl, Sarah and Gasparin, Francesca and Yuan,
               Tao and He, Hailong and Jüstel, Dominik and Pleitez, Miguel A and
               Ntziachristos, Vasilis",
  journal   = "Nat. Metab.",
  publisher = "Springer Science and Business Media LLC",
  volume    =  6,
  number    =  4,
  pages     = "678--686",
  abstract  = "Non-invasive glucose monitoring (NIGM) represents an attractive
               alternative to finger pricking for blood glucose assessment and
               management of diabetes. Nevertheless, current NIGM techniques do
               not measure glucose concentrations in blood but rely on indirect
               bulk measurement of glucose in interstitial fluid, where glucose
               is diluted and glucose dynamics are different from those in the
               blood, which impairs NIGM accuracy. Here we introduce a new
               biosensor, termed depth-gated mid-infrared optoacoustic sensor
               (DIROS), which allows, for the first time, non-invasive glucose
               detection in blood-rich volumes in the skin. DIROS minimizes
               interference caused by the stratum corneum and other superficial
               skin layers by time-gating mid-infrared optoacoustic signals to
               enable depth-selective localization of glucose readings in skin.
               In measurements on the ears of (female) mice, DIROS displays
               improved accuracy over bulk-tissue glucose measurements. Our work
               demonstrates how signal localization can improve NIGM accuracy
               and positions DIROS as a holistic approach, with high
               translational potential, that addresses a key limitation of
               current NIGM methods.",
  month     =  apr,
  year      =  2024,
  url       = "http://dx.doi.org/10.1038/s42255-024-01016-9",
  file      = "All Papers/U/Uluç et al. 2024 - Non-invasive measurements of blood glucose levels by time-gating mid-infrared optoacoustic signals.pdf",
  keywords  = "Biosensing;Electrical Engineering",
  doi       = "10.1038/s42255-024-01016-9",
  language  = "en"
}

@ARTICLE{Jankovic2025-vv,
  title     = "Wireless arm-worn bioimpedance sensor for continuous assessment
               of whole-body hydration",
  author    = "Jankovic, Matija and Kang, Seungmin and Bhattacharya, Sarnab and
               Kashanchi, Jordon and Wang, Jieting and Deoli, Kanika and Huang,
               Tianda and Johnson, Alex and Ambani, Karina and Kim, Sangjun and
               Wang, Pulin and Coyle, Edward and Lu, Nanshu",
  journal   = "Proc. Natl. Acad. Sci. U. S. A.",
  publisher = "Proceedings of the National Academy of Sciences",
  volume    =  122,
  number    =  29,
  pages     = "e2504278122",
  abstract  = "Assessment of whole-body hydration (WBH) is crucial for health
               management and disease diagnosis. Traditional methods are
               invasive or require bulky equipment, making them impractical for
               mobile, continuous sensing. We present a wearable bioimpedance
               sensor with strategic electrode placement across the arm for
               noninvasive, continuous, and mobile WBH monitoring. Although
               whole-body bioimpedance is a proven method for indicating WBH,
               the effectiveness of local bioimpedance measurement has been
               unclear. Our finite element analysis demonstrated that with an
               optimized cross-arm sensing configuration, a strong linear
               relationship exists between arm bioimpedance and muscle
               electrical resistivity, confirming the utility of arm
               bioimpedance for assessing WBH given the well-established
               relationship between muscle electrical resistivity and body
               water. Our IRB-approved diuretic-induced dehydration study
               demonstrated a strong linear correlation between the increase of
               arm bioimpedance and the decrease in body weight due to water
               loss, with a Pearson correlation coefficient of 0.956 ± 0.033
               among eight participants. Arm and whole-body demonstrated strong
               alignment, suggesting that arm bioimpedance measurements can
               reflect not only changes in WBH but also potentially absolute WBH
               status when compared against established population reference
               data. In a 24-h free-living experiment, the wireless, dry
               electrode-based, arm-conformable bioimpedance sensor continuously
               tracked dehydration and rehydration despite motions associated
               with daily activities. These results suggest that properly
               measured arm bioimpedance can serve as a surrogate for WBH,
               offering a reliable and accessible solution. The potential uses
               of this wearable technology range from improving personal
               wellness to enhancing professional sports and occupational
               safety.",
  month     =  "22~" # jul,
  year      =  2025,
  url       = "https://www.pnas.org/lookup/suppl/doi:10.1073/pnas",
  file      = "All Papers/J/Jankovic et al. 2025 - Wireless arm-worn bioimpedance sensor for continuous assessment of whole-body hydration.pdf",
  keywords  = "bioelectrical impedance vector analysis; bioimpedance;
               dehydration; flexible electronics; wearable
               electronics;Biosensing;Electrical Engineering",
  doi       = "10.1073/pnas.2504278122",
  language  = "en"
}

